{
  "expo": {
    "name": "NFHunter",
    "slug": "from-zero-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fromzeroapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "NFHunter usa la cámara para escanear el QR de los tags.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NFHunter usa tu ubicación para validar que estás junto al tag al escanearlo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NFHunter usa tus fotos para tu foto de perfil.",
          "cameraPermission": "NFHunter usa la cámara para tu foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0B1220"
  }
}

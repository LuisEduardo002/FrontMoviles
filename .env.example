# ---------------------------------------------------------------------------
# Variables de entorno de la app.
#
# Copiar este archivo como `.env` (que NO se versiona) y ajustar los valores:
#     cp .env.example .env
#
# Expo solo expone al código JavaScript las variables que empiezan por
# EXPO_PUBLIC_. Se reemplazan por su valor al compilar, así que:
#   - NUNCA poner aquí secretos (quedan en texto plano dentro del .apk/.ipa).
#   - Al cambiar un valor hay que recargar la app (no basta con guardar).
# ---------------------------------------------------------------------------

# Dirección del backend de NFHunter (NestJS + Prisma, puerto 3000).
#
# Va SIN /api: el backend no define un prefijo global, sus rutas cuelgan de la
# raíz (/auth/login, /auth/register).
#
# OJO con `localhost`: desde un celular o el emulador de Android apunta al
# propio dispositivo, no al computador.
#   - Dispositivo físico (mismo WiFi) ... http://<IP-DEL-COMPUTADOR>:3000
#   - Emulador de Android ............... http://10.0.2.2:3000
#   - Simulador de iOS / navegador ...... http://localhost:3000
#
# La IP del computador se averigua con `hostname -I` y cambia al reconectarse.
EXPO_PUBLIC_API_URL=http://192.168.114.241:3000

# Fuente de datos de los CRUD del panel admin (users, events, scans-history).
#   true  = datos en memoria, sin backend (valor por defecto, listo para entrega).
#   false = llama al backend real (rutas en src/api/users.ts, events.ts, scans.ts).
EXPO_PUBLIC_USE_MOCK=false

# Llave de Google Maps para Android (solo builds propias: dev build o APK).
# NO lleva el prefijo EXPO_PUBLIC_: no se usa en JavaScript, la lee
# `app.config.ts` al compilar y el plugin de react-native-maps la mete en el
# manifiesto nativo.
#
# - En Expo Go no hace falta: Expo trae su propia llave.
# - En iOS tampoco: el mapa usa Apple Maps.
# - Sin llave, una build Android muestra el mapa en gris (la app abre igual).
#
# Se crea en Google Cloud (Maps SDK for Android) y se restringe por el paquete
# com.nfhunter.app y el SHA-1 de la keystore de la build.
GOOGLE_MAPS_ANDROID_KEY=

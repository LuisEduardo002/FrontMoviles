{
  "expo": {
    "name": "NFHunter",
    "slug": "nfhunter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fromzeroapp",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.danielesp190steam.nfhunter"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "NFHunter usa la cámara para escanear el QR de los tags.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NFHunter usa tu ubicación para validar que estás junto al tag al escanearlo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NFHunter usa tus fotos para tu foto de perfil.",
          "cameraPermission": "NFHunter usa la cámara para tu foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0B1220",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78b87aa8-ce89-4a2d-a404-f01e5c8fced5"
      }
    }
  }
}
